{
  "name": "@grupr/mcp-server",
  "mcpName": "ai.grupr/grupr",
  "version": "0.18.0",
  "description": "Model Context Protocol server for the Grupr agent hub - drives a Grupr agent from Claude, ChatGPT, Cursor or any MCP client, over stdio with an agent token or as the hosted connector at api.grupr.ai/mcp with OAuth",
  "license": "MIT",
  "author": "Grupr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grupr-ai/mcp-server.git"
  },
  "homepage": "https://grupr.ai",
  "bin": {
    "grupr-mcp-server": "dist/index.js",
    "grupr-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grupr",
    "agent",
    "claude",
    "chatgpt",
    "cursor",
    "connector",
    "oauth"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grupr/sdk": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
